# ---------------------------------------------------------------
# Radar de Licitações MT: copie para .env e ajuste os valores.
#   cp .env.example .env
# ---------------------------------------------------------------

# Ambiente: development | test | production
APP_ENV=development
# Nível de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Formato do log: json (produção) | text (leitura no terminal)
LOG_FORMAT=text

# --- PostgreSQL (usado pelo container "db" do Docker Compose) ---
POSTGRES_USER=radar
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=radar
# Porta do Postgres exposta na sua máquina
POSTGRES_PORT=5432

# URL de conexão da aplicação (driver psycopg 3).
# Rodando a app fora do Docker use localhost; dentro do Compose ela é trocada para o host "db".
DATABASE_URL=postgresql+psycopg://radar:troque-esta-senha@localhost:5432/radar
# Mostra o SQL executado no log (apenas para depuração)
SQL_ECHO=false

# Banco dos testes de integração (o Compose cria "<POSTGRES_DB>_test" automaticamente).
# ATENÇÃO: os testes apagam e recriam todo o conteúdo deste banco.
TEST_DATABASE_URL=postgresql+psycopg://radar:troque-esta-senha@localhost:5432/radar_test

# Fuso horário para exibir datas (no banco tudo fica em UTC)
DISPLAY_TIMEZONE=America/Cuiaba
